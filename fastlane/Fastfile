require "shellwords"

default_platform(:ios)

APP_IDENTIFIER = "com.calumwebb.still"
APP_VERSION = "1.0.0"
INTERNAL_GROUP = "Owner Preview"
BETA_DESCRIPTION = "Tendr is a private, local-first companion for tracking doses, medication levels, vials, weight, schedules, and progress."
BETA_FEEDBACK_EMAIL = ENV.fetch("ASC_BETA_FEEDBACK_EMAIL")

private_lane :connect_api_key do
  key_path = ENV["ASC_KEY_PATH"]
  key_content = ENV["ASC_KEY_CONTENT"]
  UI.user_error!("Set ASC_KEY_PATH or ASC_KEY_CONTENT") if key_path.to_s.empty? && key_content.to_s.empty?

  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_filepath: key_path,
    key_content: key_content
  )
end

platform :ios do
  desc "Run the fast core test suite"
  lane :verify do
    sh("swift", "test")
  end

  desc "Run the full end-to-end simulator suite when UI behavior changes"
  lane :ui do
    run_tests(
      project: "Still.xcodeproj",
      scheme: "Still",
      devices: [ENV.fetch("TENDR_SIMULATOR", "Tend iPhone 17 Pro Max")],
      result_bundle: true,
      number_of_retries: 1,
      output_directory: "build/fastlane/tests"
    )
  end

  desc "Assign an already processed build to Owner Preview"
  lane :distribute_existing do |options|
    build_number = options[:build]
    UI.user_error!("Pass a build number, for example: fastlane ios distribute_existing build:12") if build_number.to_s.empty?

    upload_to_testflight(
      api_key: connect_api_key,
      app_identifier: APP_IDENTIFIER,
      app_platform: "ios",
      app_version: options[:version] || APP_VERSION,
      build_number: build_number.to_s,
      distribute_only: true,
      distribute_external: false,
      submit_beta_review: false,
      groups: [INTERNAL_GROUP],
      skip_waiting_for_build_processing: false,
      beta_app_description: BETA_DESCRIPTION,
      beta_app_feedback_email: BETA_FEEDBACK_EMAIL
    )
  end

  desc "Test, build, upload, wait, and distribute the next internal beta"
  lane :beta do |options|
    verify unless options[:skip_tests]
    api_key = connect_api_key
    version = options[:version] || APP_VERSION
    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      version: version,
      initial_build_number: 0
    ) + 1

    xcargs = "MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build_number}"
    export_options = {}
    profile_uuid = ENV["TENDR_PROFILE_UUID"]
    if ENV["GITHUB_ACTIONS"] == "true"
      # Xcode-managed profiles cannot be used with manual archive signing.
      # sigh selects an installed certificate and owns this separate profile.
      profile_uuid = get_provisioning_profile(
        api_key: api_key,
        app_identifier: APP_IDENTIFIER,
        provisioning_name: "Tendr CI App Store",
        ignore_profiles_with_different_name: true,
        output_path: ENV.fetch("RUNNER_TEMP"),
        filename: "tendr.mobileprovision"
      )
      UI.user_error!("CI provisioning did not return a profile UUID") if profile_uuid.to_s.empty?
    end
    unless profile_uuid.to_s.empty?
      # CI uses the sigh profile; local Xcode signing stays automatic.
      xcargs += " CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER=#{Shellwords.escape(profile_uuid)}"
      export_options = {
        signingStyle: "manual",
        signingCertificate: "Apple Distribution",
        provisioningProfiles: { APP_IDENTIFIER => profile_uuid }
      }
    end

    build_app(
      project: "Still.xcodeproj",
      scheme: "Still",
      clean: true,
      export_method: "app-store",
      output_directory: "build/fastlane",
      output_name: "Tendr-#{version}-#{build_number}.ipa",
      xcargs: xcargs,
      export_options: export_options,
      export_xcargs: profile_uuid.to_s.empty? ? "-allowProvisioningUpdates" : ""
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      app_version: version,
      build_number: build_number.to_s,
      groups: [INTERNAL_GROUP],
      distribute_external: false,
      submit_beta_review: false,
      skip_waiting_for_build_processing: false,
      beta_app_description: BETA_DESCRIPTION,
      beta_app_feedback_email: BETA_FEEDBACK_EMAIL,
      changelog: options[:changelog] || "Small interface refinements and reliability improvements."
    )
  end
end
